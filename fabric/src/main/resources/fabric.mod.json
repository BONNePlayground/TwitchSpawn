{
  "schemaVersion": 1,
  "id": "twitchspawn",
  "version": "${version}",
  "name": "TwitchSpawn",
  "description": "TwitchSpawn listens for live events related to your Twitch channel using various Socket APIs.\nThen it handles those events with the rules handcrafted by you!",
  "authors": ["iGoodie","BONNe1704"],
  "contact": {
    "homepage": ""  },
  "license": "EPL-1.0",
  "icon": "pack.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.programmer.igoodie.twitchspawn.fabric.TwitchSpawnFabric"
    ],
    "client": [
      "net.programmer.igoodie.twitchspawn.client.fabric.TwitchSpawnFabricClient"
    ]
  },
  "mixins": [
    "twitchspawn-fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": "~1.21",
    "java": ">=21"
  ,"architectury": ">=13.0.8"
  },
  "suggests": {
    "another-mod": "*"
  }
